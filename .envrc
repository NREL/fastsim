# direnv runs this file automatically when you cd into the project on linux/unix
# OS
# It keeps your Python environment in sync without manual activation.
#
# One-time setup: run `direnv allow` to approve this file.
# Install direnv: https://direnv.net/docs/installation.html

# --check ensures that substantive changes in pyproject.toml get flagged and
# --frozen prevents uv from modifying uv.lock, avoiding dirty-tree issues when
# switching branches
uv lock --check && uv sync --frozen
source .venv/bin/activate  # activate the uv-managed venv
